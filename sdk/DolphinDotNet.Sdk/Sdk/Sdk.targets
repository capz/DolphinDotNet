<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- Resolve defaults after project/local settings and Configuration are known. -->
  <PropertyGroup>
    <DndDebugSymbols Condition="'$(DndDebugSymbols)' == '' and '$(Configuration)' == 'Debug'">true</DndDebugSymbols>
    <DndDebugSymbols Condition="'$(DndDebugSymbols)' == ''">false</DndDebugSymbols>
  </PropertyGroup>
  <!-- Preserve PDB locals before CIL lowering for a debug build.
       Release builds keep their existing optimization policy. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and ('$(DndDebugSymbols)' == 'true' or '$(DndGdbTransport)' == 'Tcp' or '$(DndGdbTransport)' == 'UsbGecko')">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <!-- A direct process invocation keeps spaces, quotes and shell metacharacters
       in project/tool paths out of a command shell, on both MSBuild runtimes. -->
  <UsingTask TaskName="DndRunTool" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Text;
using Microsoft.Build.Framework;
public sealed class DndRunTool : Microsoft.Build.Utilities.Task, ICancelableTask {
  [Required] public string Tool { get; set; }
  public ITaskItem[] Arguments { get; set; }
  Process process;
  static string Quote(string value) {
    var text = new StringBuilder("\""); int slashes = 0;
    foreach (char c in value) {
      if (c == '\\') { slashes++; continue; }
      text.Append('\\', c == '"' ? slashes * 2 + 1 : slashes);
      text.Append(c); slashes = 0;
    }
    return text.Append('\\', slashes * 2).Append('"').ToString();
  }
  public override bool Execute() {
    try {
      var info = new ProcessStartInfo(Tool) { UseShellExecute = false,
        RedirectStandardOutput = true, RedirectStandardError = true };
      var property = typeof(ProcessStartInfo).GetProperty("ArgumentList");
      var list = property == null ? null : property.GetValue(info, null) as ICollection<string>;
      var quoted = new List<string>();
      foreach (var arg in Arguments ?? new ITaskItem[0]) {
        if (list != null) list.Add(arg.ItemSpec); else quoted.Add(Quote(arg.ItemSpec));
      }
      if (list == null) info.Arguments = string.Join(" ", quoted);
      using (process = new Process { StartInfo = info }) {
        process.OutputDataReceived += (s, e) => { if (e.Data != null) Log.LogMessageFromText(e.Data, MessageImportance.High); };
        process.ErrorDataReceived += (s, e) => {
          if (e.Data == null) return;
          if (e.Data.StartsWith("dndc: ", StringComparison.Ordinal))
            Log.LogError("DolphinDotNet", "DND002", null, null, 0, 0, 0, 0, e.Data.Substring(6));
          else Log.LogMessageFromText(e.Data, MessageImportance.High);
        };
        process.Start(); process.BeginOutputReadLine(); process.BeginErrorReadLine();
        process.WaitForExit();
        if (process.ExitCode != 0 && !Log.HasLoggedErrors) Log.LogError("DolphinDotNet build failed with exit code {0}.", process.ExitCode);
        return process.ExitCode == 0 && !Log.HasLoggedErrors;
      }
    } catch (Exception e) { Log.LogError("DolphinDotNet: {0}", e.Message); return false; }
    finally { process = null; }
  }
  public void Cancel() {
    try {
      if (process == null || process.HasExited) return;
      var kill = typeof(Process).GetMethod("Kill", new[] { typeof(bool) });
      if (kill != null) kill.Invoke(process, new object[] { true }); else process.Kill();
    } catch (Exception) { }
  }
}
      ]]></Code>
    </Task>
  </UsingTask>
  <PropertyGroup>
    <_DndBuildProject>$(_DndRoot)/tools/DolphinDotNet.Build/DolphinDotNet.Build.csproj</_DndBuildProject>
    <_DndCompilerProject>$(_DndRoot)/tools/DolphinDotNet.Compiler/DolphinDotNet.Compiler.csproj</_DndCompilerProject>
    <_DndTools>$(_DndRoot)/tools/DolphinDotNet.Build/bin/$(Configuration)/net8.0/</_DndTools>
    <_DndCompiler>$(_DndRoot)/tools/DolphinDotNet.Compiler/bin/$(Configuration)/net8.0/DolphinDotNet.Compiler.dll</_DndCompiler>
    <_DndTools Condition="'$(_DndPackaged)' == 'true'">$(_DndPackageRoot)tools/build/</_DndTools>
    <_DndCompiler Condition="'$(_DndPackaged)' == 'true'">$(_DndPackageRoot)tools/compiler/DolphinDotNet.Compiler.dll</_DndCompiler>
    <_DndEffects>$(_DndRoot)/tools/DolphinDotNet.Effects/bin/$(Configuration)/net8.0/DolphinDotNet.Effects.dll</_DndEffects>
    <_DndEffects Condition="'$(_DndPackaged)' == 'true'">$(_DndPackageRoot)tools/effects/DolphinDotNet.Effects.dll</_DndEffects>
    <_DndDotnet Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_DndDotnet>
    <_DndDotnet Condition="'$(_DndDotnet)' == ''">dotnet</_DndDotnet>
    <DolphinUserDirectory Condition="'$(DolphinUserDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)dolphin-user'))</DolphinUserDirectory>
    <RunCommand>$(_DndDotnet)</RunCommand>
    <RunArguments>&quot;$(TargetDir)DolphinDotNet.Build.dll&quot; run --config &quot;$(TargetDir)dolphin-run.json&quot;</RunArguments>
    <RunArguments Condition="'$(Configuration)' == 'Debug' and '$(DndDebugSymbols)' == 'true'">$(RunArguments) --gdb-port 2166</RunArguments>
    <RunWorkingDirectory>$(TargetDir)</RunWorkingDirectory>
  </PropertyGroup>
  <!-- Build host tools through the project graph. Rebuilding them inside BuildDol
       can delete outputs already scheduled by a parallel solution build. -->
  <ItemGroup Condition="'$(_DndPackaged)' != 'true' and '$(DndBuildNative)' == 'true' and '$(OutputType)' != 'Library'">
    <ProjectReference Include="$(_DndBuildProject);$(_DndCompilerProject)"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'@(DndEffect)' != ''">
    <Compile Remove="@(DndEffect->'%(GeneratedSource)')" />
    <Compile Include="@(DndEffect->'%(GeneratedSource)')" />
  </ItemGroup>
  <Target Name="CompileDndEffects" BeforeTargets="CoreCompile"
          Condition="'@(DndEffect)' != '' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'%(DndEffect.GeneratedSource)' == '' or '%(DndEffect.ClassName)' == ''"
           Text="DndEffect requires GeneratedSource and ClassName metadata." />
    <MSBuild Condition="'$(_DndPackaged)' != 'true'" Projects="$(_DndRoot)/tools/DolphinDotNet.Effects/DolphinDotNet.Effects.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="OutputPath;BaseOutputPath;BaseIntermediateOutputPath;IntermediateOutputPath;TargetFramework;RuntimeIdentifier;SelfContained;DndBuildNative" />
    <MakeDir Directories="$(IntermediateOutputPath)dnd-effects" />
    <DndRunTool Tool="$(_DndDotnet)" Arguments="$(_DndEffects);%(DndEffect.FullPath);$(IntermediateOutputPath)dnd-effects/%(DndEffect.Filename).dndfx;%(DndEffect.GeneratedSource);%(DndEffect.ClassName)" />
  </Target>
  <Target Name="BuildDol" AfterTargets="Build"
          Condition="'$(DndBuildNative)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' != 'false' and '$(IsCrossTargetingBuild)' != 'true' and '$(OutputType)' != 'Library'">
    <Delete Files="$(TargetDir)$(AssemblyName).dol;$(TargetDir)$(AssemblyName).elf;$(TargetDir)$(AssemblyName).dnd-debug.json;$(TargetDir)$(AssemblyName).dnd-addresses.json;$(TargetDir)dolphin-run.json" />
    <PropertyGroup>
      <_DndNative>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)native'))</_DndNative>
    </PropertyGroup>
    <ItemGroup>
      <_DndArgs Include="$(_DndTools)DolphinDotNet.Build.dll;build;--assembly;$(TargetPath);--compiler;$(_DndCompiler);--native-directory;$(_DndNative);--dol;$(TargetDir)$(AssemblyName).dol;--elf;$(TargetDir)$(AssemblyName).elf;--run-config;$(TargetDir)dolphin-run.json;--backend;$(DndBuildBackend);--jobs;$(DndBuildJobs);--user-directory;$(DolphinUserDirectory)" />
      <_DndArgs Include="--dolphin;$(DolphinPath)" Condition="'$(DolphinPath)' != ''" />
      <_DndArgs Include="--sample-controls;$(DndSampleControls)" Condition="'$(DndSampleControls)' != ''" />
      <_DndArgs Include="--debug-symbols;$(DndDebugSymbols);--gdb-transport;$(DndGdbTransport)" />
      <_DndArgs Include="--gdb-ip;$(DndGdbIp);--gdb-netmask;$(DndGdbNetmask);--gdb-gateway;$(DndGdbGateway);--gdb-port;$(DndGdbPort)"
                Condition="'$(DndGdbTransport)' == 'Tcp' or '$(DndGdbTransport)' == 'tcp' or '$(DndGdbTransport)' == 'TCP'" />
      <_DndArgs Include="--gdb-channel;$(DndGdbChannel)" Condition="'$(DndGdbTransport)' == 'UsbGecko' or '$(DndGdbTransport)' == 'usbgecko' or '$(DndGdbTransport)' == 'USBGECKO'" />
    </ItemGroup>
    <DndRunTool Tool="$(_DndDotnet)" Arguments="@(_DndArgs)" />
    <ItemGroup>
      <_DndLauncher Include="$(_DndTools)DolphinDotNet.Build.dll;$(_DndTools)DolphinDotNet.Build.deps.json;$(_DndTools)DolphinDotNet.Build.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_DndLauncher)" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="CleanDol" AfterTargets="Clean" Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(IntermediateOutputPath)native" />
    <Delete Files="$(TargetDir)$(AssemblyName).dol;$(TargetDir)$(AssemblyName).elf;$(TargetDir)$(AssemblyName).dnd-debug.json;$(TargetDir)$(AssemblyName).dnd-addresses.json;$(TargetDir)dolphin-run.json;$(TargetDir)DolphinDotNet.Build.dll;$(TargetDir)DolphinDotNet.Build.deps.json;$(TargetDir)DolphinDotNet.Build.runtimeconfig.json" />
  </Target>
  <Target Name="Run" DependsOnTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_DndRunArgs Include="$(TargetDir)DolphinDotNet.Build.dll;run;--config;$(TargetDir)dolphin-run.json" />
    </ItemGroup>
    <DndRunTool Tool="$(_DndDotnet)" Arguments="@(_DndRunArgs)" />
  </Target>
</Project>
