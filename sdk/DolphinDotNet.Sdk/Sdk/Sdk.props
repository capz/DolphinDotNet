<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <_DndRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</_DndRoot>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Visual Studio must invoke MSBuild for every real Build/Run. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <DndBuildNative Condition="'$(DndBuildNative)' == ''">true</DndBuildNative>
    <DndBuildBackend Condition="'$(DndBuildBackend)' == ''">Auto</DndBuildBackend>
    <DndBuildJobs Condition="'$(DndBuildJobs)' == ''">2</DndBuildJobs>
  </PropertyGroup>
  <Import Project="$(MSBuildProjectDirectory)/DolphinDotNet.local.props" Condition="Exists('$(MSBuildProjectDirectory)/DolphinDotNet.local.props')" />
</Project>
