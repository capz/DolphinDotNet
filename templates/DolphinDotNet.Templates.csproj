<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../eng/Package.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput><IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders><NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking><NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**"
             PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
