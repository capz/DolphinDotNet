<idea-plugin>
    <id>com.dolphindotnet.debugger</id>
    <name>DolphinDotNet</name>
    <vendor>DolphinDotNet</vendor>
    <description>Attach to an already-running Dolphin or GameCube GDB target using the DolphinDotNet DAP adapter.</description>
    <depends>com.intellij.modules.rider</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="com.dolphindotnet.rider.AttachConfigurationType"/>
        <programRunner implementation="com.dolphindotnet.rider.AttachRunner"/>
        <xdebugger.breakpointType implementation="com.dolphindotnet.rider.SourceBreakpointType"/>
    </extensions>
    <actions>
        <action id="DolphinDotNet.Attach" class="com.dolphindotnet.rider.AttachAction"
                text="Attach to DolphinDotNet…" description="Attach Rider to a running Dolphin or GameCube debug build">
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
